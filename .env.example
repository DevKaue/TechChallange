# Copie para .env e ajuste conforme o seu ambiente.
#
# Os testes NÃO precisam deste arquivo: test/setup/test-env.ts já fornece
# defaults para as três suítes. Ele é necessário para rodar a aplicação
# (`npm run start:dev`), que carrega .env via dotenv em src/main.ts.

# Banco. Fora do container, use a porta publicada pelo compose (5433).
# Dentro do compose, o host é `db` e a porta 5432.
DATABASE_URL=postgresql://admin:adminpassword@localhost:5433/oficinadb?schema=public

# Obrigatórias: validateEnv() derruba a aplicação no boot sem DATABASE_URL e JWT_SECRET.
JWT_SECRET=troque_este_valor

# Salt fixo do ScryptPasswordHasher. Trocar invalida todas as senhas já gravadas.
PASSWORD_SALT=troque_este_valor

PORT=3000

SONAR_ADMIN_PASSWORD=SonarAdmin123!
